# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Embeddings & Vector Store Configuration
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_FALLBACK_MODEL=all-MiniLM-L6-v2
# Optional: External OpenAI/Ollama-compatible embedding endpoint URL if hosting model externally
# EMBEDDING_API_URL=http://localhost:11434/v1/embeddings
# EMBEDDING_API_KEY=
TOP_K=3
SIMILARITY_THRESHOLD=0.08
HYBRID_ALPHA=0.7

# Chunking Configuration (Recursive Character Text Splitter)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
